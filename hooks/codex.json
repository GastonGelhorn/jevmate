{
  "description": "jevmate for Codex: a Bash guard, long output trimmed, red test runs sorted, fetched content screened, and compaction that keeps what the work still needs.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "JEV_HOST=codex python3 \"${PLUGIN_ROOT}/bin/jev\" hook session-start",
            "commandWindows": "set \"JEV_HOST=codex\" && py -3 \"%PLUGIN_ROOT%\\bin\\jev\" hook session-start",
            "timeout": 20,
            "additionalContextLimit": 3000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "JEV_HOST=codex python3 \"${PLUGIN_ROOT}/bin/jev\" hook route",
            "commandWindows": "set \"JEV_HOST=codex\" && py -3 \"%PLUGIN_ROOT%\\bin\\jev\" hook route",
            "timeout": 6
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "JEV_HOST=codex python3 \"${PLUGIN_ROOT}/bin/jev\" hook guard",
            "commandWindows": "set \"JEV_HOST=codex\" && py -3 \"%PLUGIN_ROOT%\\bin\\jev\" hook guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "JEV_HOST=codex python3 \"${PLUGIN_ROOT}/bin/jev\" hook after-bash",
            "commandWindows": "set \"JEV_HOST=codex\" && py -3 \"%PLUGIN_ROOT%\\bin\\jev\" hook after-bash",
            "timeout": 25
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "JEV_HOST=codex python3 \"${PLUGIN_ROOT}/bin/jev\" hook pre-compact",
            "commandWindows": "set \"JEV_HOST=codex\" && py -3 \"%PLUGIN_ROOT%\\bin\\jev\" hook pre-compact",
            "timeout": 120,
            "statusMessage": "jev: judging tool results before the compaction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "JEV_HOST=codex python3 \"${PLUGIN_ROOT}/bin/jev\" hook stop",
            "commandWindows": "set \"JEV_HOST=codex\" && py -3 \"%PLUGIN_ROOT%\\bin\\jev\" hook stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
